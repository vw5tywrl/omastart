#!/usr/bin/env python3
"""Entrypoint for Omarchy Startup (Qt6 Quick / Quickshell UI + JSON backend + CLI)."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))


def _handle_backend(subcmd: str, payload_raw: str) -> int:
    data = json.loads(payload_raw) if payload_raw else {}

    if subcmd == "scan":
        from omarchy_startup.collector import collect_all_startup_data

        s = collect_all_startup_data()
        out = {
            "totalTime": s.total_time,
            "userspaceTime": s.userspace_time,
            "graphicalTime": s.graphical_time,
            "rawBreakdown": s.raw_breakdown,
            "stages": s.stages,
            "slowestUnits": s.slowest_units,
            "criticalChain": s.critical_chain,
            "items": [i.to_ui_dict() for i in s.items],
        }
        print(json.dumps(out, ensure_ascii=False))
        return 0

    if subcmd == "apps":
        from omarchy_startup.collector import list_installed_desktop_apps

        print(json.dumps({"apps": list_installed_desktop_apps()}, ensure_ascii=False))
        return 0

    if subcmd == "toggle":
        from omarchy_startup.actions import set_item_enabled_raw

        ok, msg = set_item_enabled_raw(data["item"], bool(data["enable"]))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "add-hypr":
        from omarchy_startup.actions import add_hyprland_startup_entry

        ok, msg = add_hyprland_startup_entry(data.get("command", ""))
        print(
            json.dumps({"ok": ok, "message": msg, "closeAdd": ok}, ensure_ascii=False)
        )
        return 0

    if subcmd == "add-hook":
        from omarchy_startup.actions import add_post_boot_hook

        ok, msg = add_post_boot_hook(
            data.get("name", ""),
            data.get("description", ""),
            data.get("command", ""),
        )
        print(
            json.dumps({"ok": ok, "message": msg, "closeAdd": ok}, ensure_ascii=False)
        )
        return 0

    if subcmd == "delete":
        from omarchy_startup.actions import delete_user_item_raw

        ok, msg = delete_user_item_raw(data["item"])
        print(
            json.dumps(
                {"ok": ok, "message": msg, "closeInspector": ok}, ensure_ascii=False
            )
        )
        return 0

    if subcmd == "run-now":
        from omarchy_startup.actions import run_item_now_raw

        ok, msg = run_item_now_raw(data["item"])
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "logs":
        from omarchy_startup.actions import fetch_unit_logs_raw

        logs = fetch_unit_logs_raw(data["item"], lines=40)
        print(json.dumps({"logs": logs}, ensure_ascii=False))
        return 0

    if subcmd == "open-dir":
        from omarchy_startup.actions import open_dir_raw

        ok, msg = open_dir_raw(data.get("path", ""))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "open-editor":
        from omarchy_startup.actions import open_in_editor_raw

        ok, msg = open_in_editor_raw(data.get("item", {}))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "mask":
        from omarchy_startup.actions import mask_item_raw

        ok, msg = mask_item_raw(data.get("item", {}))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "settings-get":
        from omarchy_startup.actions import get_settings_raw

        print(json.dumps(get_settings_raw(), ensure_ascii=False))
        return 0

    if subcmd == "settings-set":
        from omarchy_startup.actions import save_settings_raw

        ok, msg = save_settings_raw(data)
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "snapshot-save":
        from omarchy_startup.actions import save_snapshot_raw

        ok, msg = save_snapshot_raw(data.get("name", ""))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "snapshot-list":
        from omarchy_startup.actions import list_snapshots_raw

        print(json.dumps({"snapshots": list_snapshots_raw()}, ensure_ascii=False))
        return 0

    if subcmd == "snapshot-restore":
        from omarchy_startup.actions import restore_snapshot_raw

        ok, msg = restore_snapshot_raw(data.get("id", ""))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    print(json.dumps({"ok": False, "message": f"Unknown command: {subcmd}"}))
    return 1


def main() -> int:
    # Dedicated fast-path for Quickshell backend calls
    if "--backend" in sys.argv:
        idx = sys.argv.index("--backend")
        subcmd = sys.argv[idx + 1] if len(sys.argv) > idx + 1 else ""
        payload = sys.argv[idx + 2] if len(sys.argv) > idx + 2 else ""
        return _handle_backend(subcmd, payload)

    parser = argparse.ArgumentParser(
        prog="omarchy-startup",
        description="Dead-simple startup package and service manager for Omarchy.",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List startup packages and services in the terminal",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Include disabled units with --list or --json",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output startup state as JSON",
    )
    parser.add_argument(
        "--critical-chain",
        action="store_true",
        help="Print the systemd critical-chain dependency tree",
    )
    args = parser.parse_args()

    # CLI subcommands: snapshot, critical-chain
    cmd_tokens = [a for a in sys.argv[1:] if not a.startswith("-")]
    if cmd_tokens:
        primary = cmd_tokens[0]
        if primary == "critical-chain":
            args.critical_chain = True
        elif primary == "snapshot":
            from omarchy_startup.actions import (
                list_snapshots_raw,
                restore_snapshot_raw,
                save_snapshot_raw,
            )

            sub = cmd_tokens[1] if len(cmd_tokens) > 1 else "list"
            if sub == "save":
                name = cmd_tokens[2] if len(cmd_tokens) > 2 else ""
                ok, msg = save_snapshot_raw(name)
                print(msg)
                return 0 if ok else 1
            elif sub == "restore":
                if len(cmd_tokens) < 3:
                    print("Usage: omastart snapshot restore <snapshot_id>")
                    return 1
                ok, msg = restore_snapshot_raw(cmd_tokens[2])
                print(msg)
                return 0 if ok else 1
            elif sub == "list":
                snaps = list_snapshots_raw()
                if not snaps:
                    print("No snapshots found in ~/.config/omastart/snapshots/")
                    return 0
                print(f"{'ID':<24} {'LABEL':<24} {'ITEMS':<8} {'TIMESTAMP'}")
                print("-" * 72)
                for s in snaps:
                    print(
                        f"{s['id']:<24} {s['label']:<24} {s['itemCount']:<8} {s['timestamp']}"
                    )
                return 0

    if args.critical_chain:
        from omarchy_startup.collector import _collect_critical_chain

        tree = _collect_critical_chain()
        if not tree:
            print("No critical-chain data available from systemd.")
            return 1
        for node in tree:
            dur = f" (+{node['duration']})" if node["duration"] else ""
            print(f"{'  ' * (node['indent'] // 2)}{node['unit']} @{node['activeAt']}{dur}")
        return 0

    if args.list or args.json:
        from omarchy_startup.collector import collect_all_startup_data

        summary = collect_all_startup_data()
        items = [
            i
            for i in summary.items
            if i.source.value != "desktop-app" and (args.all or i.enabled)
        ]
        if args.json:
            print(
                json.dumps(
                    {
                        "totalTime": summary.total_time,
                        "userspaceTime": summary.userspace_time,
                        "graphicalTime": summary.graphical_time,
                        "items": [i.to_ui_dict() for i in items],
                    },
                    indent=2,
                    ensure_ascii=False,
                )
            )
            return 0

        print(
            f"boot: total {summary.total_time}  ·  userspace {summary.userspace_time}  ·  graphical {summary.graphical_time}"
        )
        print("-" * 96)
        print(f"{'LAYER':<18} {'NAME':<32} {'PACKAGE':<22} {'STATE':<16} {'BOOT'}")
        print("-" * 96)
        for it in items:
            print(
                f"{it.source.label:<18.18} {it.name:<32.32} {it.package_key:<22.22} "
                f"{it.running_label:<16.16} {it.boot_time_formatted}"
            )
        return 0

    qml_entry = PROJECT_ROOT / "qml" / "Main.qml"
    env = os.environ.copy()
    env["OMARCHY_STARTUP_BIN"] = str(Path(__file__).resolve())
    os.execvpe("quickshell", ["quickshell", "-p", str(qml_entry)], env)


if __name__ == "__main__":
    raise SystemExit(main())
