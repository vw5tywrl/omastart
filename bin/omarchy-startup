#!/usr/bin/env python3
"""Entrypoint for Omarchy Startup (Qt6 Quick / Quickshell UI + JSON backend + CLI)."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

PROJECT_ROOT = Path(__file__).resolve().parent.parent
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))


def _handle_backend(subcmd: str, payload_raw: str) -> int:
    data = json.loads(payload_raw) if payload_raw else {}

    if subcmd == "scan":
        from omarchy_startup.collector import collect_all_startup_data

        s = collect_all_startup_data()
        out = {
            "totalTime": s.total_time,
            "userspaceTime": s.userspace_time,
            "graphicalTime": s.graphical_time,
            "rawBreakdown": s.raw_breakdown,
            "items": [i.to_ui_dict() for i in s.items],
        }
        print(json.dumps(out, ensure_ascii=False))
        return 0

    if subcmd == "apps":
        from omarchy_startup.collector import list_installed_desktop_apps

        print(json.dumps({"apps": list_installed_desktop_apps()}, ensure_ascii=False))
        return 0

    if subcmd == "toggle":
        from omarchy_startup.actions import set_item_enabled_raw

        ok, msg = set_item_enabled_raw(data["item"], bool(data["enable"]))
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "add-hypr":
        from omarchy_startup.actions import add_hyprland_startup_entry

        ok, msg = add_hyprland_startup_entry(data.get("command", ""))
        print(
            json.dumps({"ok": ok, "message": msg, "closeAdd": ok}, ensure_ascii=False)
        )
        return 0

    if subcmd == "add-hook":
        from omarchy_startup.actions import add_post_boot_hook

        ok, msg = add_post_boot_hook(
            data.get("name", ""),
            data.get("description", ""),
            data.get("command", ""),
        )
        print(
            json.dumps({"ok": ok, "message": msg, "closeAdd": ok}, ensure_ascii=False)
        )
        return 0

    if subcmd == "delete":
        from omarchy_startup.actions import delete_user_item_raw

        ok, msg = delete_user_item_raw(data["item"])
        print(
            json.dumps(
                {"ok": ok, "message": msg, "closeInspector": ok}, ensure_ascii=False
            )
        )
        return 0

    if subcmd == "run-now":
        from omarchy_startup.actions import run_item_now_raw

        ok, msg = run_item_now_raw(data["item"])
        print(json.dumps({"ok": ok, "message": msg}, ensure_ascii=False))
        return 0

    if subcmd == "logs":
        from omarchy_startup.actions import fetch_unit_logs_raw

        logs = fetch_unit_logs_raw(data["item"], lines=40)
        print(json.dumps({"logs": logs}, ensure_ascii=False))
        return 0

    if subcmd == "open-dir":
        p = Path(data.get("path", ""))
        folder = p.parent if p.is_file() else p
        if folder.exists():
            subprocess.Popen(
                ["uwsm-app", "--", "xdg-open", str(folder)],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            print(json.dumps({"ok": False, "message": f"Opened {folder}"}))
        else:
            print(json.dumps({"ok": False, "message": "Directory not found"}))
        return 0

    print(json.dumps({"ok": False, "message": f"Unknown command: {subcmd}"}))
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="omarchy-startup",
        description="Dead-simple startup package and service manager for Omarchy.",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List startup packages and services in the terminal",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Include disabled units with --list or --json",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Output startup state as JSON",
    )
    parser.add_argument(
        "--backend",
        metavar="CMD",
        help=argparse.SUPPRESS,
    )
    parser.add_argument(
        "payload",
        nargs="?",
        default="",
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()

    if args.backend:
        return _handle_backend(args.backend, args.payload)

    if args.list or args.json:
        from omarchy_startup.collector import collect_all_startup_data

        summary = collect_all_startup_data()
        items = [i for i in summary.items if (args.all or i.enabled)]
        if args.json:
            print(
                json.dumps(
                    {
                        "totalTime": summary.total_time,
                        "userspaceTime": summary.userspace_time,
                        "graphicalTime": summary.graphical_time,
                        "items": [i.to_ui_dict() for i in items],
                    },
                    indent=2,
                    ensure_ascii=False,
                )
            )
            return 0

        print(
            f"boot: total {summary.total_time}  ·  userspace {summary.userspace_time}  ·  graphical {summary.graphical_time}"
        )
        print("-" * 96)
        print(f"{'LAYER':<18} {'NAME':<32} {'PACKAGE':<22} {'STATE':<16} {'BOOT'}")
        print("-" * 96)
        for it in items:
            print(
                f"{it.source.label:<18.18} {it.name:<32.32} {it.package_key:<22.22} "
                f"{it.running_label:<16.16} {it.boot_time_formatted}"
            )
        return 0

    qml_entry = PROJECT_ROOT / "qml" / "Main.qml"
    env = os.environ.copy()
    env["OMARCHY_STARTUP_BIN"] = str(Path(__file__).resolve())
    os.execvpe("quickshell", ["quickshell", "-p", str(qml_entry)], env)


if __name__ == "__main__":
    raise SystemExit(main())
